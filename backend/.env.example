# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local: mongodb://127.0.0.1:27017/dr_appointment_db
# Atlas: mongodb+srv://<user>:<password>@<cluster-url>/dr_appointment_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/dr_appointment_db

# ---- Auth ----
# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
